{
  "expo": {
    "name": "CrankPack",
    "slug": "EngineAPp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "crankpack",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.crankpack.app",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "CrankPack connects to your backpack charger over Bluetooth.",
        "NSLocationWhenInUseUsageDescription": "CrankPack uses GPS on this phone to track hike distance, speed, and elevation."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#070A08",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.crankpack.app",
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#070A08"
        }
      ],
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": true,
          "modes": ["central"],
          "bluetoothAlwaysPermission": "CrankPack connects to your backpack charger over Bluetooth."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "CrankPack uses GPS on this phone to track hike distance, speed, and elevation."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
